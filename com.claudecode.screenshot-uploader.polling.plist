<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Auto-upload daemon, polling mode.
    setup.sh replaces the __PLACEHOLDER__ values; launchd does not expand ~ or
    environment variables in any of these keys, so they must be absolute paths.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudecode.screenshot-uploader.polling</string>

    <key>ProgramArguments</key>
    <array>
        <string>__INSTALL_DIR__/uploader-polling.sh</string>
    </array>

    <!-- Seconds between checks: lower means less delay, more wakeups. -->
    <key>StartInterval</key>
    <integer>2</integer>

    <key>StandardOutPath</key>
    <string>/tmp/screenshot-uploader.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/screenshot-uploader-error.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>1</integer>
</dict>
</plist>
